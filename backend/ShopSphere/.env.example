# ==========================================
# SHOPSPHERE ENVIRONMENT VARIABLES EXAMPLE
# ==========================================

# Database
DB_URL=jdbc:postgresql://localhost:5432/shopsphere
DB_USERNAME=shopsphere_user
DB_PASSWORD=Abhipra@7667

# Security / JWT
JWT_SECRET=ShopSphereSecretKeyForJwtTokenGeneration2026Secure

# Email Provider Configuration (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_DEV_MODE=false
EMAIL_DNS_MX_CHECK=true

# SMS Provider Configuration (TWILIO / MSG91 / EXOTEL / DEV)
SMS_PROVIDER=TWILIO
SMS_DEV_MODE=false

# Twilio Credentials (If SMS_PROVIDER=TWILIO)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# MSG91 Credentials (If SMS_PROVIDER=MSG91)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_dlt_template_id
MSG91_SENDER_ID=SHPSPH

# OTP Security Settings
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_DEV_MODE=false

# Disposable Email API (Optional)
DISPOSABLE_EMAIL_API_KEY=your_disposable_email_api_key
DISPOSABLE_EMAIL_API_URL=https://disposable.debounce.io/?email={email}
